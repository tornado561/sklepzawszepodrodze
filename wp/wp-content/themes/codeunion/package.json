{
	"name": "codeunion-theme",
	"version": "2.1.37.2",
	"private": true,
	"type": "module",
	"author": {
		"name": "Szymon Konieczny",
		"email": "szymon.konieczny@codeunion.dev",
		"url": "https://codeunion.dev/"
	},
	"scripts": {
		"development": "vite",
		"build": "npm run delete-hotfile && vite build && mv public/build/.vite/manifest.json public/build/manifest.json && rm -r public/build/.vite",
		"make-hotfile": "touch public/hotfile",
		"delete-hotfile": "rm -f public/hotfile",
		"dev": "node -r on-exit ./vite-codeunion.cjs",
		"format": "prettier --write \"src/**/*.{js,ts,vue,scss,css}\" \"includes/blocks/**/*.{js,ts,vue,scss,css}\"",
		"lint:js": "eslint --config eslint.config.mjs --ext .js,.vue src",
		"fix:js": "eslint --config eslint.config.mjs --ext .js,.vue --fix src",
		"lint:scss": "stylelint \"src/scss/**/*.scss\" \"includes/blocks/**/*.scss\"",
		"fix:scss": "stylelint --fix \"src/scss/**/*.scss\" \"includes/blocks/**/*.scss\""
	},
	"dependencies": {
		"axios": "^1.4.0",
		"cross-spawn": "^7.0.3",
		"glightbox": "^3.2.0",
		"gsap": "^3.12.7",
		"keen-slider": "^6.8.6",
		"leaflet": "^1.9.4",
		"on-exit": "^1.0.1",
		"sass": "^1.64.2",
		"vue": "^3.2.47"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^7.26.10",
		"@vitejs/plugin-vue": "^5.2.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"eslint-plugin-vue": "^10.0.0",
		"prettier": "^3.5.3",
		"stylelint": "^16.15.0",
		"stylelint-config-recommended-scss": "^14.1.0",
		"stylelint-config-standard": "^37.0.0",
		"stylelint-order": "^6.0.4",
		"vite": "^6.2.0",
		"vite-plugin-full-reload": "^1.2.0",
		"vue-eslint-parser": "^10.1.1"
	}
}
